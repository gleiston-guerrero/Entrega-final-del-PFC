{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "title": "REQUEST RATE",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (job) (rate(http_server_requests_seconds_count[5m]))", "legendFormat": "{{job}}"}],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 2,
      "title": "LATENCIA HTTP p50 / p95 / p99",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p50"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p95"},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "p99"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 3,
      "title": "ERRORES HTTP 5XX",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (job) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))", "legendFormat": "{{job}}"}],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 4,
      "title": "COCKROACHDB - SALUD Y OPERACION",
      "description": "Estado del cluster CockroachDB y metricas de acceso JDBC observadas por Reservas. Las series de retries y conexiones pueden valer cero legitimamente.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "max(liveness_livenodes{job=\"crdb-e3-cluster\"})", "legendFormat": "nodos vivos"},
        {"refId": "B", "expr": "sum(ranges_unavailable{job=\"crdb-e3-cluster\"})", "legendFormat": "rangos no disponibles"},
        {"refId": "C", "expr": "max(crdb_pool_active_connections{job=\"reservas-solicitudes-service\"})", "legendFormat": "conexiones activas"},
        {"refId": "D", "expr": "increase(crdb_transaction_retries_total{job=\"reservas-solicitudes-service\"}[5m])", "legendFormat": "reintentos 5m"},
        {"refId": "E", "expr": "histogram_quantile(0.95, sum by (le) (rate(crdb_query_duration_seconds_bucket{job=\"reservas-solicitudes-service\"}[5m])))", "legendFormat": "p95 JDBC"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": [
        {"matcher": {"id": "byFrameRefID", "options": "E"}, "properties": [{"id": "unit", "value": "s"}, {"id": "custom.axisPlacement", "value": "right"}]}
      ]},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 5,
      "title": "RECURSOS DE CONTENEDORES",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "100 * sum by (container) (label_replace(rate(container_cpu_usage_seconds_total{job=\"cadvisor\",id=~\"/system.slice/docker-.*[.]scope\",cpu=\"total\"}[5m]), \"container\", \"$1\", \"id\", \".*/docker-([0-9a-f]{12}).*\"))", "legendFormat": "CPU {{container}}"},
        {"refId": "B", "expr": "sum by (container) (label_replace(container_memory_working_set_bytes{job=\"cadvisor\",id=~\"/system.slice/docker-.*[.]scope\"}, \"container\", \"$1\", \"id\", \".*/docker-([0-9a-f]{12}).*\"))", "legendFormat": "RAM {{container}}"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "fieldConfig": {"defaults": {}, "overrides": [
        {"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "unit", "value": "percent"}]},
        {"matcher": {"id": "byFrameRefID", "options": "B"}, "properties": [{"id": "unit", "value": "bytes"}]}
      ]},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 6,
      "title": "LATENCIA E2E MOVIL P95",
      "description": "Latencia p95 medida desde la aplicacion Android como tiempo HTTP observado en el dispositivo. La medicion se reporta al backend y se expone mediante Prometheus; no es un proxy del Gateway.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(app_mobile_http_latency_seconds_bucket{job=\"reservas-solicitudes-service\"}[5m])))", "legendFormat": "p95 movil E2E"}],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    }
  ],
  "refresh": "15s",
  "schemaVersion": 40,
  "tags": ["scli", "entrega-4", "observabilidad"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "PFC - Observabilidad consolidada",
  "uid": "pfc-observabilidad",
  "version": 1
}
